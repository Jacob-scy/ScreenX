{
    "name": "screenx",
    "productName": "ScreenX",
    "version": "1.0.0",
    "description": "ScreenX - 轻量级 Windows 截图与桌面效率工具",
    "main": "./out/main/main.js",
    "scripts": {
        "pack": "npm run build && electron-builder --dir -c electron-builder.config.js",
        "dist": "npm run build && electron-builder -p never -c electron-builder.config.js",
        "start": "electron-vite --ignoreConfigWarning preview",
        "dev": "electron-vite --ignoreConfigWarning dev",
        "build:native": "powershell -ExecutionPolicy Bypass -Command \"if (-not (Test-Path resources/bin/wincapture.exe)) { New-Item -ItemType Directory -Path resources/bin -Force | Out-Null; & 'C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe' /target:exe /optimize+ /out:resources/bin/wincapture.exe /r:System.Drawing.dll src/main/native/WinCapture.cs }\"",
        "build": "pnpm run build:native && electron-vite --ignoreConfigWarning build",
        "ana": "electron-vite --ignoreConfigWarning preview --mode analyze",
        "uitest": "electron-vite -c electron.vite.config_test.ts",
        "typecheck": "npx tsc -b --noEmit",
        "format": "npx biome format --write src/",
        "lint": "npx biome check src/",
        "fix": "biome check --write src/",
        "test": "vitest run",
        "diagnose:screenshot": "electron scripts/diagnose_screenshot.js",
        "build:release": "node scripts/build-release.js",
        "deploy:site": "node scripts/deploy-site.js",
        "publish:r2": "node scripts/publish-r2.js",
        "release": "pnpm run build:release && pnpm run publish:r2 && pnpm run deploy:site"
    },
    "author": {
        "name": "ScreenX Contributors",
        "url": "https://screenx.jacobscy.xyz"
    },
    "homepage": "https://screenx.jacobscy.xyz",
    "license": "GPL-3.0",
    "packageManager": "pnpm@10.17.0",
    "dependencies": {
        "@pdf-lib/upng": "^1.0.1",
        "@xushengfeng/fasttext_wasm": "1.0.6",
        "bmp-js": "^0.1.0",
        "chroma-js": "^3.1.1",
        "diff-match-patch": "^1.0.5",
        "diff-match-patch-line-and-word": "^0.1.3",
        "dkh-ui": "^0.14.2",
        "edge_det": "^0.1.3",
        "esearch-ocr": "8.5.2",
        "esearch-seg": "1.1.9",
        "fabric": "^7.4.0",
        "fuse.js": "^7.1.0",
        "hex-to-css-filter": "^5.4.0",
        "hotkeys-js": "^3.13.7",
        "minimist": "^1.2.8",
        "myde-dbus": "^0.5.2",
        "node-screenshots": "^0.2.8",
        "onnxruntime-node": "^1.27.0",
        "picture_match": "^0.1.4",
        "remarkable": "^2.0.1",
        "uiohook-napi": "^1.5.4",
        "xtranslator": "^1.5.9",
        "yauzl": "^3.2.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@inquirer/prompts": "^8.2.0",
        "@types/bmp-js": "^0.1.2",
        "@types/chroma-js": "^3.1.1",
        "@types/diff-match-patch": "^1.0.34",
        "@types/minimist": "^1.2.5",
        "@types/node": "^22.9.3",
        "@types/remarkable": "^2.0.8",
        "@types/yauzl": "^2.10.3",
        "canvas": "^3.1.0",
        "csv-parse": "^5.5.5",
        "electron": "43.4.0",
        "electron-builder": "^26.15.7",
        "electron-vite": "^4.0.1",
        "inquirer": "^12.7.0",
        "typescript": "^5.8.3",
        "vite": "^7.3.6",
        "vite-bundle-analyzer": "^1.2.0",
        "vite-plugin-image-optimizer": "^1.1.8",
        "vitest": "^4.1.10",
        "wrangler": "4.135.0",
        "xtimelog": "^1.0.5"
    },
    "optionalDependencies": {
        "node-screenshots-darwin-arm64": "0.2.8",
        "node-screenshots-darwin-x64": "0.2.8",
        "node-screenshots-linux-arm64-gnu": "0.2.8",
        "node-screenshots-linux-loong64-gnu": "0.2.8",
        "node-screenshots-linux-x64-gnu": "0.2.8",
        "node-screenshots-linux-x64-musl": "0.2.8",
        "node-screenshots-win32-arm64-msvc": "0.2.8",
        "node-screenshots-win32-ia32-msvc": "0.2.8",
        "node-screenshots-win32-x64-msvc": "0.2.8"
    }
}
