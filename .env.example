# ScreenX 环境变量模板
# Electron 桌面应用，多数变量为构建/开发时使用，运行时通常无需配置

# === 开发模式 ===
SCREENX_DEV=true          # 开发模式标志（true/false）
ELECTRON_RENDERER_URL=http://localhost:5173  # 开发时渲染进程 URL

# === 构建/发布代理（可选） ===
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897
ALL_PROXY=http://127.0.0.1:7897

# === 构建架构（可选） ===
M_ARCH=x64  # x64 / arm64
